{
  "name": "convozy",
  "private": true,
  "version": "0.1.0",
  "description": "Instagram comment-to-DM automation platform (monorepo root)",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter='./apps/*' dev",
    "build": "pnpm --recursive --filter='./apps/*' --filter='./packages/*' build",
    "lint": "pnpm --recursive --filter='./apps/*' --filter='./packages/*' lint",
    "test": "pnpm --recursive --filter='./apps/*' --filter='./packages/*' test",
    "typecheck": "pnpm --recursive --filter='./apps/*' --filter='./packages/*' typecheck",
    "docker:dev": "docker compose -f docker-compose.yml up --build",
    "docker:prod": "docker compose -f docker-compose.prod.yml up --build -d"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "pnpm": {
    "overrides": {
      "tar": ">=7.5.22"
    }
  }
}
