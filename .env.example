# Copy to .env (dev) and fill in real values. Never commit the real .env file.
# Every variable here is validated at boot by apps/api/src/config/env.validation.ts
# — the app fails fast if one is missing/invalid rather than failing at first use.

# ── General ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Dev default shown below. Production value: https://convozy.orincore.com
APP_BASE_URL=http://localhost:3001

# ── Database ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://convozy:convozy@localhost:5432/convozy

# ── Redis (BullMQ + dedup + rate limiting) ──────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Auth ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-random-64-char-hex-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── Secret encryption (Instagram tokens at rest) ────────────────────────
# Must be a 32-byte key, hex-encoded (64 hex chars). Generate with:
# openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=replace-with-a-random-64-char-hex-string

# ── Meta app (webhook signature verification - see webhooks module) ────
# From your Meta developer app's Settings -> Basic (developers.facebook.com/apps)
META_APP_ID=
META_APP_SECRET=
# Any string you choose — Meta echoes it back during webhook subscription
META_WEBHOOK_VERIFY_TOKEN=choose-a-random-string
META_GRAPH_API_VERSION=v21.0
META_OAUTH_REDIRECT_URI=http://localhost:3000/api/instagram/oauth/callback

# ── Business Login for Instagram (Instagram connect flow - no Facebook ─
# ── Page required) ──────────────────────────────────────────────────────
# Has its OWN App ID/Secret, distinct from META_APP_ID above. Find at:
# App Dashboard -> Instagram -> "API setup with Instagram login" ->
# 3. Set up Instagram business login -> Business login settings.
# Add META_OAUTH_REDIRECT_URI above as a redirect URI there too.
META_INSTAGRAM_APP_ID=
META_INSTAGRAM_APP_SECRET=

# ── Google OAuth (account login/signup) ─────────────────────────────────
# From console.cloud.google.com → APIs & Services → Credentials → OAuth
# client ID (type: Web application). Authorized redirect URI must exactly
# match GOOGLE_OAUTH_REDIRECT_URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# Frontend page that receives the one-time exchange code after OAuth login
FRONTEND_OAUTH_CALLBACK_URL=http://localhost:3001/auth/callback

# ── Stripe (global payments) ────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Razorpay (India payments) ───────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── AI provider (provider-agnostic — see apps/api/src/modules/ai) ──────
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=

# ── Worker/queue concurrency tuning ─────────────────────────────────────
QUEUE_CONCURRENCY_WEBHOOK=20
QUEUE_CONCURRENCY_MESSAGE_SEND=10
QUEUE_CONCURRENCY_AI=5

# ── Postgres container credentials (docker-compose dev only) ───────────
POSTGRES_USER=convozy
POSTGRES_PASSWORD=convozy
POSTGRES_DB=convozy
